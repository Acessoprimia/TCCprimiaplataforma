<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuracoes - Painel Administrativo Primia</title>
    <link href="/css/admin.css" rel="stylesheet">
    <%- include('../../partials/headeradmin.ejs') %>
</head>

<body>
    <main class="admin-page">
        <section class="admin-mobile-intro">
            <p class="admin-kicker">Painel Administrativo</p>
            <h1>Configuracoes</h1>
            <p>Ajustes gerais de textos, banners e recursos premium do site.</p>
        </section>

        <%- include('../../partials/adminSidebar.ejs', { activeAdminPage: 'configuracoes' }) %>

        <section class="admin-content">
            <section class="admin-panel" id="configuracoes">
                <header class="panel-header">
                    <article>
                        <h2>Configuracoes gerais</h2>
                        <p>Esses valores aparecem em paginas publicas do site (aviso no topo, texto e imagem da home, area premium) e no e-mail de "Fale conosco".</p>
                    </article>
                </header>

                <form class="settings-form" id="formConfiguracoes">
                    <label>
                        Texto institucional
                        <textarea name="texto_institucional" rows="4" placeholder="Texto exibido na pagina inicial"><%= config.texto_institucional %></textarea>
                    </label>
                    <label>
                        Aviso do site
                        <input type="text" name="aviso_site" value="<%= config.aviso_site %>" placeholder="Ex: Novos simulados disponiveis esta semana">
                    </label>
                    <label>
                        Recurso premium em destaque
                        <select name="recurso_premium_destaque">
                            <option value="">Nenhum</option>
                            <option value="Simulados exclusivos" <%= config.recurso_premium_destaque === 'Simulados exclusivos' ? 'selected' : '' %>>Simulados exclusivos</option>
                            <option value="Videoaulas premium" <%= config.recurso_premium_destaque === 'Videoaulas premium' ? 'selected' : '' %>>Videoaulas premium</option>
                            <option value="Planos personalizados" <%= config.recurso_premium_destaque === 'Planos personalizados' ? 'selected' : '' %>>Planos personalizados</option>
                        </select>
                    </label>
                    <label>
                        Periodo de teste premium
                        <input type="text" name="periodo_teste_premium" value="<%= config.periodo_teste_premium %>" placeholder="Ex: Teste uma semana gratis">
                    </label>
                    <label>
                        E-mail de contato
                        <input type="email" name="email_contato_destino" value="<%= config.email_contato_destino %>" placeholder="Recebe as mensagens de Fale conosco">
                    </label>
                    <button class="admin-button primary" type="submit">Salvar configuracoes</button>
                </form>

                <form class="settings-form" id="formBannerConfiguracoes" style="margin-top: 24px;">
                    <label>
                        Banner principal
                        <% if (config.banner_principal_url) { %>
                            <img src="<%= config.banner_principal_url %>" alt="Banner principal atual" style="max-width: 240px; border-radius: 12px; margin-bottom: 8px;">
                        <% } %>
                        <input type="file" name="banner" accept="image/*">
                    </label>
                    <button class="admin-button primary" type="submit">Atualizar banner</button>
                </form>
            </section>
        </section>
    </main>

    <%- include('../../partials/adminModals.ejs') %>

    <script src="/js/admin/common.js"></script>
    <script src="/js/admin/configuracoes.js"></script>
    <%- include('../../partials/footer.ejs') %>
</body>

</html>
