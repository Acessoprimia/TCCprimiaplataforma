<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Primia</title>

    <link href="../css/partepremium.css" rel="stylesheet">
    <%- include('../partials/header.ejs') %>
</head>

<body>
    <!-- CONTEÚDO PRINCIPAL -->
    <main class="perfil-container">
        <!-- CARD DE PERFIL -->
        <article class="perfil-card">
            <!-- INFORMAÇÕES DO USUÁRIO -->
            <section class="usuario-info">
                <figure class="avatar-container">
                    <img src="<%= (typeof usuario !== 'undefined' && usuario.foto_url) ? usuario.foto_url : '../image/usuario.webp' %>" alt="Avatar do usuário" class="avatar">
                </figure>
                <article class="info-texto">
                    <h1 class="nome-usuario"><%= typeof usuario !== 'undefined' ? usuario.nome : 'Usuario do Aluno' %></h1>
                    <p class="email-usuario"><%= typeof usuario !== 'undefined' ? usuario.email : 'usuarioaluno@gmail.com' %></p>
                    <span class="matricula-usuario">RA: <%= typeof usuario !== 'undefined' && usuario.ra ? usuario.ra : '0000' %></span> <br>
                    <span class="matricula-usuario">Série: <%= typeof usuario !== 'undefined' && usuario.serie ? usuario.serie : 'Não informada' %></span>
                </article>
                <a href="/editarperfil" class="btn-editar">Editar perfil</a>
            </section>

            <!-- MENU DE NAVEGAÇÃO -->
            <nav class="menu-navegacao">
                <a href="/areadosimulado" class="menu-item">
                    <figure class="icone-menu">
                        <img src="../image/avaliacao.webp" alt="Fórum" class="icone">
                    </figure>
                    <span class="texto-menu">Area dos simulados</span>
                    <span class="seta-menu">›</span>
                </a>


                <a href="/video" class="menu-item">
                    <figure class="icone-menu">
                        <img src="../image/video.webp" alt="Biblioteca" class="icone">
                    </figure>
                    <span class="texto-menu">Video-Aulas</span>
                    <span class="seta-menu">›</span>
                </a>

                <a href="/cronograma" class="menu-item">
                    <figure class="icone-menu">
                        <img src="../image/calendariologo.webp" alt="Premium" class="icone">
                    </figure>
                    <span class="texto-menu">Cronogramas</span>
                    <span class="seta-menu">›</span>
                </a>

                <a href="/redacao" class="menu-item">
                    <figure class="icone-menu">
                        <svg class="icone icone-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                            <path d="m15 5 4 4"></path>
                        </svg>
                    </figure>
                    <span class="texto-menu">Redação</span>
                    <span class="seta-menu">›</span>
                </a>

            </nav>
        </article>
    </main>

</body>
<%- include('../partials/footer.ejs') %>

</html>