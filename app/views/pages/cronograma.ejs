<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cronogramas</title>
    <link href="../css/cronograma.css" rel="stylesheet">
    <%- include("../partials/headerpremium.ejs") %>
</head>

<body>
    <main>
        <h1>Cronogramas</h1>
        <p class="subtitulo-cronograma">Cronogramas publicados pelos professores para alunos premium.</p>

        <section class="cards-container">
            <% if (cronogramas.length === 0) { %>
                <p class="cronogramas-vazio">Nenhum cronograma publicado ainda.</p>
            <% } %>
            <% cronogramas.forEach(function (cronograma) { %>
                <a href="/cronograma/<%= cronograma.codigo_lote %>" class="cronograma-link">
                    <article class="cronograma-card">
                        <h2><%= cronograma.titulo_cronograma %></h2>
                        <p class="cronograma-card-info"><%= cronograma.materia %> · Prof. <%= cronograma.professor %></p>
                        <p class="cronograma-card-info"><%= cronograma.total_eventos %> evento<%= cronograma.total_eventos > 1 ? 's' : '' %></p>
                    </article>
                </a>
            <% }) %>
        </section>
    </main>

    <%- include("../partials/footer.ejs") %>
</body>

</html>
