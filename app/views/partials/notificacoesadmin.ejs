<article class="notif-dropdown" id="notif-dropdown">
    <header class="notif-topo">
        <h3>Alertas admin</h3>
    </header>

    <ul class="notif-lista" id="notif-lista">
        <% const listaNotificacoesAdmin = typeof notificacoesAdmin !== 'undefined' ? notificacoesAdmin : []; %>
        <% if (!listaNotificacoesAdmin.length) { %>
            <li class="notif-item">
                <p class="notif-texto">Nenhuma pendencia no momento.</p>
                <time class="notif-tempo">agora</time>
            </li>
        <% } %>
        <% listaNotificacoesAdmin.forEach((item) => { %>
            <li class="notif-item nova">
                <a href="<%= item.link %>" class="notif-link">
                    <p class="notif-texto"><%= item.texto %></p>
                    <time class="notif-tempo"><%= item.tempo %></time>
                </a>
            </li>
        <% }) %>
    </ul>

    <footer class="notif-rodape">
        <a href="/admin/suporte">Ver pendencias</a>
    </footer>
</article>
