<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= video.titulo %></title>
    <link href="../css/videoaula.css" rel="stylesheet">
    <%- include("../partials/header.ejs") %>
</head>

<body>
    <main>
        <section class="video-container">
            <% if (urlEmbed) { %>
                <iframe
                    src="<%= urlEmbed %>"
                    title="<%= video.titulo %>"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    width="100%"
                    height="480"
                ></iframe>
            <% } else { %>
                <p>Não foi possível carregar este vídeo.</p>
            <% } %>
        </section>

        <article class="content">
            <h1><%= video.titulo %></h1>
            <% if (video.materia) { %>
                <p class="subtitle"><%= video.materia %></p>
            <% } %>
            <p><%= video.descricao || 'Sinopse ainda não cadastrada para esta vídeo-aula.' %></p>
        </article>
    </main>
    <%- include("../partials/footer.ejs") %>
</body>

</html>
