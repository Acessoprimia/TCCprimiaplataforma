<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Videoaulas</title>
    <link href="../css/video.css" rel="stylesheet">
    <%- include("../partials/headerpremium.ejs") %>
</head>

<body>
    <main>
        <h1>Videoaulas</h1>

        <section class="filter-section">
            <label for="materia-filter">
                <svg class="filter-icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" />
                </svg>
                Filtro
            </label>
            <select id="materia-filter">
                <option value="">Todas as matérias</option>
                <% materias.forEach(function (materia) { %>
                    <option value="<%= materia.slug %>"><%= materia.nome %></option>
                <% }) %>
            </select>
        </section>

        <section class="cards-container">
            <% if (videos.length === 0) { %>
                <p class="videos-vazio">Nenhuma vídeo-aula publicada ainda.</p>
            <% } %>

            <% videos.forEach(function (video) { %>
                <article data-materia="<%= video.materiaSlug %>">
                    <a href="/videoaula/<%= video.id %>">
                        <img src="<%= video.imagem_url || '../image/lousa.webp' %>" alt="<%= video.titulo %>" class="card-image">
                        <section class="card-content">
                            <h2><%= video.titulo %></h2>
                            <p><%= video.descricao || 'Sinopse ainda não cadastrada.' %></p>
                        </section>
                    </a>
                </article>
            <% }) %>
        </section>
    </main>

    <%- include("../partials/footer.ejs") %>

        <script src="../js/video.js"></script>
</body>

</html>
