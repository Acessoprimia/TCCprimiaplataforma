<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link href="../css/cronograma.css" rel="stylesheet">
    <link href="../css/gradecronograma.css" rel="stylesheet">
    <% if (ehProfessor) { %>
        <%- include("../partials/headerprofessorpremium.ejs") %>
    <% } else { %>
        <%- include("../partials/headerpremium.ejs") %>
    <% } %>
</head>

<body>
    <main class="com-grade">
        <a href="<%= rotaVolta %>" class="voltar-link">&larr; Voltar aos cronogramas</a>
        <h1><%= titulo %></h1>
        <p class="subtitulo-cronograma"><%= materia %><%= professor ? ' · Prof. ' + professor : '' %></p>

        <section class="grade-container">
            <%- include("../partials/gradecronograma.ejs", { grade: grade }) %>
        </section>

        <% if (ehProprio) { %>
            <section class="prioridades">
                <h2 class="titulo-secao">Meus itens</h2>
                <%- include('../partials/listaprioridades.ejs', { itens: itens, voltarPara: voltarPara }) %>
            </section>
        <% } %>
    </main>

    <%- include("../partials/footer.ejs") %>
</body>

</html>
