<link rel="stylesheet" href="../css/hdeslogado.css">
<link rel="stylesheet" href="../css/cookiebanner.css">

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Aplica o tema salvo (Configuracoes > Aparencia) antes da 1a pintura,
       pra pagina nao "piscar" clara e depois trocar pra escura. -->
  <script>
    (function () {
      try {
        var tema = localStorage.getItem("primia-tema");
        if (tema === "light" || tema === "dark") {
          document.documentElement.setAttribute("data-theme", tema);
        }
        var fonte = localStorage.getItem("primia-fonte");
        if (fonte === "grande" || fonte === "extra") {
          document.documentElement.setAttribute("data-fonte", fonte);
        }
      } catch (e) {}
    })();
  </script>
  <title></title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%- include('./pwa.ejs') %>
  <link href="../css/theme.css" rel="stylesheet">
  <link href="../css/header.css" rel="stylesheet">
</head>
<body>
  <a class="skip-link" href="#conteudo-principal">Pular para o conteudo</a>

  <!-- Overlay escuro -->
  <aside class="overlay" id="overlay" aria-hidden="true"></aside>

  <!-- Header -->
  <header class="site-header">
    <section class="header-inner">

      <!-- Logo -->
      <a href="/entradaprofessor" class="logo">
        <img src="../image/logofooter.webp" alt="Logo Primia" />
      </a>

      <!-- Menu Desktop -->
      <nav class="nav-desktop" aria-label="Menu principal desktop">
        <ul>
          <li><a href="/entradaprofessor">Início</a></li>
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
      </nav>

      <!-- Sino + Botão Sair agrupados -->
      <span class="header-acoes">

        <span class="sino-container">
            <a href="#" class="nav-sino" id="sino-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <span class="sino-contador" id="sino-contador" style="<%= totalNotificacoesNaoLidas ? '' : 'display:none;' %>"><%= totalNotificacoesNaoLidas || 0 %></span>
            </a>
            <%- include('./notificacoes.ejs') %>
        </span>

        <a href="/configuracoes" class="nav-config" id="config-btn" aria-label="Configurações">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
        </a>

        <a href="/logout" class="btn-login">Sair</a>

      </span>

      <!-- Botão hamburguer -->
      <button class="hamburger" id="hamburger" aria-label="Abrir menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>

    </section>
  </header>

  <!-- Menu Mobile -->
  <nav class="nav-mobile" id="navMobile" aria-label="Menu principal mobile">
    <ul>
      <li><a href="/entradaprofessor">Início</a></li>
      <li><a href="/sobre">Sobre</a></li>
      <li><a href="/contato">Contato</a></li>
      <li><a href="/configuracoes">Configurações</a></li>
      <li><a href="/logout" class="mobile-login-btn">SAIR</a></li>
    </ul>
  </nav>

  <!-- JavaScript -->
  <% if (!emPaginaPublica && usuarioHeader) { %>
    <%- include('./navInferior.ejs', { tipo: 'professor' }) %>
  <% } %>

  <script src="../js/hamburguer.js"></script>

<!-- Alvo do skip link: primeiro ponto depois do cabecalho repetido -->
  <span id="conteudo-principal" tabindex="-1"></span>
</body>
</html>
