<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= livro.titulo %> - Detalhes do Livro</title>
    <%- include('../partials/header.ejs') %>
        <link rel="stylesheet" href="../css/livro.css">
        <script>
            const LIVRO_ID = <%- JSON.stringify(livro.id) %>;
            const LIVRO_TITULO = <%- JSON.stringify(livro.titulo) %>;
        </script>

</head>

<body>
    <main>
        <!-- Seção do cabeçalho com imagem do livro -->
        <section class="book-header">
            <button class="back-button" onclick="goBack()" aria-label="Voltar"></button>
            <button class="menu-button" onclick="toggleMenu()" aria-label="Menu de opções"></button>

            <figure class="book-cover">
                <img src="<%= livro.imagem_url || '../image/escolab.webp' %>" alt="Capa do livro <%= livro.titulo %>">
            </figure>
        </section>

        <!-- Informações do livro -->
        <section class="book-info">
            <h1><%= livro.titulo %></h1>
            <% if (livro.materia) { %>
                <p class="subtitle"><%= livro.materia %></p>
            <% } %>
            <% if (livro.autor) { %>
                <p class="authors"><%= livro.autor %></p>
            <% } %>

            <a class="read-button" href="<%= livro.arquivo_url %>" target="_blank" rel="noopener">Leia o livro</a>
        </section>

        <!-- Sinopse -->
        <section class="synopsis">
            <h2>Sinopse:</h2>
            <p>
                <%= livro.descricao || 'Sinopse ainda não cadastrada para este livro.' %>
            </p>
        </section>
    </main>

    <!-- Overlay do modal -->
    <aside class="modal-overlay" id="modalOverlay" onclick="fecharModaisLivro()"></aside>

    <!-- Modal de opções -->
    <aside class="options-modal" id="optionsModal">
        <header>
            <h3>Opções</h3>
            <button class="close-modal" onclick="toggleMenu()" aria-label="Fechar">✕</button>
        </header>

        <ul class="options-list">
            <li>
                <button class="share" onclick="shareBook()">Compartilhar</button>
            </li>
            <li>
                <button class="report" onclick="reportBook()">Denunciar</button>
            </li>
        </ul>
    </aside>

    <!-- Modal de denuncia -->
    <aside class="options-modal report-modal" id="reportModal">
        <header>
            <h3>Denunciar livro</h3>
            <button class="close-modal" onclick="toggleReportModal()" aria-label="Fechar">✕</button>
        </header>

        <form id="reportForm">
            <label class="report-field">
                Motivo
                <select name="motivo" required>
                    <option value="" disabled selected>Selecione um motivo</option>
                    <option value="Conteudo incorreto">Conteudo incorreto</option>
                    <option value="Direitos autorais">Direitos autorais</option>
                    <option value="Material desatualizado">Material desatualizado</option>
                    <option value="Outro motivo">Outro motivo</option>
                </select>
            </label>

            <label class="report-field">
                Detalhes (opcional)
                <textarea name="descricao" rows="4" placeholder="Descreva o problema encontrado..."></textarea>
            </label>

            <button type="submit" class="report-submit">Enviar denuncia</button>
        </form>
    </aside>

    <script src="../js/points.js"></script>
</body>
<%- include('../partials/footer.ejs') %>

</html>
