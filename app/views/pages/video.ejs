<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Videoaulas</title>
    <link href="../css/video.css" rel="stylesheet">
    <%- include("../partials/headerpremium.ejs") %>
</head>

<body>
    <main>
        <h1>Videoaulas</h1>

        <%- include('../partials/filtroPadrao.ejs', { opcoesFiltro: materias.map(function (m) { return { valor: m.slug, nome: m.nome }; }) }) %>

        <section class="cards-container">
            <% if (videos.length === 0) { %>
                <p class="videos-vazio">Nenhuma vídeo-aula publicada ainda.</p>
            <% } %>

            <% videos.forEach(function (video) { %>
                <article data-materia="<%= video.materiaSlug %>">
                    <% if (video.is_premium) { %>
                        <span class="badge-premium">Premium</span>
                    <% } %>
                    <a href="/videoaula/<%= video.id %>">
                        <img src="<%= video.imagem_url || '../image/lousa.webp' %>" alt="<%= video.titulo %>" class="card-image">
                        <section class="card-content">
                            <h2><%= video.titulo %></h2>
                            <p><%= video.descricao || 'Sinopse ainda não cadastrada.' %></p>
                        </section>
                    </a>
                </article>
            <% }) %>
        </section>
    </main>

    <%- include("../partials/footer.ejs") %>

        <script src="../js/video.js"></script>
</body>

</html>
