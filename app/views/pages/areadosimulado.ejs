<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meus Simulados - Primia</title>

    <link href="../css/areadosimulado.css" rel="stylesheet">
    <%- include('../partials/headerpremium.ejs') %>
</head>

<body>
    <!-- SEÇÃO PRINCIPAL -->
    <main class="container-simulados">
        <!-- TÍTULO -->
        <h1 class="titulo-simulados">Meus simulados</h1>

        <!-- GERAR NOVO SIMULADO -->
        <section class="gerar-simulado-container">
            <h2>Gerar simulado com IA</h2>
            <form action="/areadosimulado/gerar" method="POST" class="gerar-simulado-form">
                <input type="text" name="tema" placeholder="Sobre qual tema? Ex: Frações e números racionais" required>
                <select name="materia_id">
                    <option value="">Sem matéria específica</option>
                    <% materias.forEach(function (materia) { %>
                        <option value="<%= materia.id_materia %>"><%= materia.nome %></option>
                    <% }) %>
                </select>
                <select name="quantidade">
                    <% for (let i = 1; i <= 10; i++) { %>
                        <option value="<%= i %>" <%= i === 5 ? 'selected' : '' %>><%= i %> pergunta<%= i > 1 ? 's' : '' %></option>
                    <% } %>
                </select>
                <select name="dificuldade">
                    <option value="facil">Fácil</option>
                    <option value="medio" selected>Médio</option>
                    <option value="dificil">Difícil</option>
                </select>
                <button type="submit">Gerar</button>
            </form>
        </section>

        <!-- ABAS DE FILTRO -->
        <nav class="abas-filtro">
            <button class="aba-botao aba-ativa" data-filtro="andamento">
                Em andamento
            </button>
            <button class="aba-botao" data-filtro="finalizados">
                Finalizados
            </button>
        </nav>

        <!-- SEÇÃO DE FILTRO -->
        <section class="secao-filtro">
            <figure class="icone-filtro">
                <img src="../image/filtro.webp" alt="Filtro" class="icone">
            </figure>
            <span class="texto-filtro">Filtro</span>
        </section>

        <!-- MODAL DE FILTRO (com elemento dialog) -->
        <dialog class="modal-filtro" id="modalFiltro">
            <article class="modal-conteudo">
                <button class="fechar-modal">&times;</button>
                <h3>Selecione A Disciplina:</h3>
                <form id="formFiltro">
                    <% materias.forEach(function (materia) { %>
                        <label><input type="checkbox" name="disciplina" value="<%= materia.nome %>"> <%= materia.nome %></label>
                    <% }) %>
                    <button type="submit" class="botao-buscar">Buscar</button>
                </form>
            </article>
        </dialog>

        <!-- SEÇÃO DE SIMULADOS EM ANDAMENTO -->
        <section class="secao-simulados" id="secao-andamento">
            <% if (emAndamento.length === 0) { %>
                <p class="simulados-vazio">Nenhum simulado em andamento. Gere um acima!</p>
            <% } %>
            <% emAndamento.forEach(function (formulario) { %>
                <article class="card-simulado" data-status="andamento" data-disciplina="<%= formulario.materia || '' %>">
                    <h2 class="titulo-simulado"><%= formulario.titulo %></h2>
                    <p class="origem-simulado"><%= formulario.origem %><% if (formulario.materia) { %> · <%= formulario.materia %><% } %></p>
                    <a href="/simulado/<%= formulario.id_formulario %>" class="botao-simulado botao-andamento">Faça</a>
                </article>
            <% }) %>
        </section>

        <!-- SEÇÃO DE SIMULADOS FINALIZADOS (OCULTA POR PADRÃO) -->
        <section class="secao-simulados oculta" id="secao-finalizados">
            <% if (finalizados.length === 0) { %>
                <p class="simulados-vazio">Nenhum simulado finalizado ainda.</p>
            <% } %>
            <% finalizados.forEach(function (formulario) { %>
                <article class="card-simulado" data-status="finalizados" data-disciplina="<%= formulario.materia || '' %>">
                    <h2 class="titulo-simulado"><%= formulario.titulo %></h2>
                    <p class="origem-simulado"><%= formulario.origem %><% if (formulario.materia) { %> · <%= formulario.materia %><% } %></p>
                    <a href="/simulado/<%= formulario.id_formulario %>" class="botao-simulado botao-finalizado">Ver resultado</a>
                </article>
            <% }) %>
        </section>
    </main>

    <script src="../js/areadosimulado.js"></script>
    <%- include('../partials/footer.ejs') %>
</body>

</html>
