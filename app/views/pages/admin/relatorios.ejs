```html
<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Relatórios - Painel Administrativo Primia</title>

    <link href="/css/admin.css" rel="stylesheet">

    <%- include('../../partials/headeradmin.ejs') %>

</head>

<body>

    <main class="admin-page">

        <section class="admin-mobile-intro">

            <p class="admin-kicker">Painel Administrativo</p>

            <h1>Relatórios</h1>

            <p>Indicadores gerais de crescimento e engajamento da plataforma.</p>

        </section>

        <%- include('../../partials/adminSidebar.ejs', { activeAdminPage: 'relatorios' }) %>


        <section class="admin-panel" id="relatorios">

            <header class="panel-header">

                <hgroup>

                    <h2>Relatórios administrativos</h2>

                    <p>Indicadores, gráficos e resumo mensal de crescimento e engajamento.</p>

                </hgroup>

            </header>

            <% // Filtro de periodo: controla o intervalo usado para calcular os cards, os %>
            <% // graficos e a tabela abaixo. "Personalizado" revela o seletor de datas. %>

            <search class="admin-filtros-painel">

                <fieldset class="admin-filtro-bloco">

                    <legend class="admin-filtros-label">Período</legend>

                    <nav class="admin-filtros" aria-label="Filtrar relatórios por período">

                        <button type="button" class="filtro-btn" data-filtro-periodo="7d">Últimos 7 dias</button>

                        <button type="button" class="filtro-btn ativo" data-filtro-periodo="30d">Últimos 30 dias</button>

                        <button type="button" class="filtro-btn" data-filtro-periodo="12m">Últimos 12 meses</button>

                        <button type="button" class="filtro-btn" data-filtro-periodo="personalizado">Personalizado</button>

                    </nav>

                </fieldset>

                <form class="admin-filtro-periodo-personalizado oculto" id="periodoPersonalizado">

                    <label>

                        De

                        <input type="date" id="periodoDataInicio">

                    </label>

                    <label>

                        Até

                        <input type="date" id="periodoDataFim">

                    </label>

                    <button type="button" class="admin-button primary" id="periodoAplicar">Aplicar</button>

                </form>

            </search>

            <% // Os cards abaixo sao calculados a partir de REGISTROS_DIARIOS_RELATORIOS_MOCK em %>
            <% // tempo de execucao, comparando o periodo selecionado com o periodo anterior de %>
            <% // mesma duracao. O array agora vem pronto do banco (registrosDiarios abaixo), so %>
            <% // o nome da variavel client-side ficou igual pra nao mudar a logica de agregacao. %>

            <aside class="resumo-cards" id="relatoriosResumo"></aside>

            <ul class="charts-grid">

                <li><article class="admin-panel chart-panel">

                    <header class="panel-header">

                        <hgroup>

                            <h2>Crescimento de usuários</h2>

                            <p>Novos alunos e professores por período.</p>

                        </hgroup>

                    </header>

                    <figure class="chart-frame" id="graficoUsuariosFrame"></figure>

                    <ul class="chart-caption" id="graficoUsuariosLegenda"></ul>

                </article></li>

                <li><article class="admin-panel chart-panel">

                    <header class="panel-header">

                        <hgroup>

                            <h2>Conteúdos publicados</h2>

                            <p>Volume de publicações por período.</p>

                        </hgroup>

                    </header>

                    <figure class="chart-frame" id="graficoConteudosFrame"></figure>

                </article></li>

            </ul>

            <ul class="charts-grid">

                <li><article class="admin-panel chart-panel">

                    <header class="panel-header">

                        <hgroup>

                            <h2>Assinaturas Premium</h2>

                            <p>Novas assinaturas premium ao longo do tempo.</p>

                        </hgroup>

                    </header>

                    <figure class="chart-frame" id="graficoPremiumFrame"></figure>

                </article></li>

                <li><article class="admin-panel">

                    <header class="panel-header">

                        <hgroup>

                            <h2>Conteúdos publicados por matéria</h2>

                            <p>Não existe rastreamento de acesso no banco ainda - isto mostra volume de material publicado por matéria no período, uma medida indireta de popularidade.</p>

                        </hgroup>

                    </header>

                    <figure id="graficoMateriasFrame"></figure>

                </article></li>

            </ul>

            <section class="admin-panel">

                <header class="panel-header">

                    <hgroup>

                        <h2>Resumo mensal</h2>

                        <p>Novos alunos, professores, conteúdos e premiums vendidos, mês a mês.</p>

                    </hgroup>

                </header>

                <figure class="table-scroll">

                    <table class="admin-table">

                        <thead>

                            <tr>

                                <th>Mês</th>

                                <th>Novos alunos</th>

                                <th>Novos professores</th>

                                <th>Conteúdos publicados</th>

                                <th>Premiums vendidos</th>

                            </tr>

                        </thead>

                        <tbody id="relatoriosTabela"></tbody>

                    </table>

                </figure>

            </section>

        </section>


    </main>

    <script id="dados-relatorios" type="application/json"><%- jsonParaScript(registrosDiarios) %></script>

    <script id="dados-materias-relatorio" type="application/json"><%- jsonParaScript(materias) %></script>

    <script src="/js/admin/relatorios.js"></script>

    <%- include('../../partials/footer.ejs') %>

</body>

</html>
```
