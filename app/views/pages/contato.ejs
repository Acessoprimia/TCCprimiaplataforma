<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contato - Plataforma Primia</title>



  <%- include('../partials/header.ejs') %>
    <link rel="stylesheet" href="../css/contato.css" />
</head>

<body>

  <main class="contato-container">
    <h1 class="contato-titulo">Plataforma Primia</h1>

    <section class="form-container">
      <h2>Fale Conosco</h2>

      <% if (typeof msgSucesso !== 'undefined' && msgSucesso) { %>
        <p class="sucesso-msg"><%= msgSucesso %></p>
      <% } %>
      <% if (typeof msgErro !== 'undefined' && msgErro && msgErro.geral) { %>
        <p class="erro-msg"><%= msgErro.geral %></p>
      <% } %>

      <form action="/contato" method="POST">
        <label for="nome">Nome</label>
        <input type="text" id="nome" name="nome" placeholder="Seu nome"
          value="<%= typeof valores !== 'undefined' && valores.nome ? valores.nome : '' %>">
        <% if (typeof msgErro !== 'undefined' && msgErro && msgErro.nome) { %>
          <p class="erro-msg"><%= msgErro.nome %></p>
        <% } %>

        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" placeholder="seuemail@exemplo.com"
          value="<%= typeof valores !== 'undefined' && valores.email ? valores.email : '' %>">
        <% if (typeof msgErro !== 'undefined' && msgErro && msgErro.email) { %>
          <p class="erro-msg"><%= msgErro.email %></p>
        <% } %>

        <label for="assunto">Assunto</label>
        <input type="text" id="assunto" name="assunto" placeholder="Sobre o que voce quer falar?"
          value="<%= typeof valores !== 'undefined' && valores.assunto ? valores.assunto : '' %>">

        <label for="mensagem">Mensagem</label>
        <textarea id="mensagem" name="mensagem" placeholder="Digite sua mensagem..."><%= typeof valores !== 'undefined' && valores.mensagem ? valores.mensagem : '' %></textarea>
        <% if (typeof msgErro !== 'undefined' && msgErro && msgErro.mensagem) { %>
          <p class="erro-msg"><%= msgErro.mensagem %></p>
        <% } %>

        <button type="submit">Enviar</button>
      </form>
    </section>
  </main>


</body>
<%- include('../partials/footer.ejs') %>

</html>