<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biblioteca - Primia</title>

    <link href="../css/biblioteca.css" rel="stylesheet">
    <%- include('../partials/header.ejs') %>
</head>

<body>
    <!-- HEADER -->
    <header class="biblioteca-header">
        <h1>Biblioteca</h1>
    </header>

    <!-- FILTRO -->
    <nav class="filtro-container">
        <button class="filtro-btn" id="openFilter">
            <span class="filtro-icon"></span>
            Filtro
        </button>
    </nav>

    <!-- MODAL DE FILTRO -->
    <aside class="modal-overlay" id="modalOverlay">
        <section class="modal-content">
            <button class="close-modal" id="closeModal">&times;</button>
            <header class="modal-header">
                <h2>Selecione A Disciplina:</h2>
            </header>
            <form class="disciplinas-list">
                <% materias.forEach(function (materia) { %>
                    <label class="disciplina-item">
                        <input type="checkbox" id="<%= materia.slug %>" value="<%= materia.slug %>">
                        <span><%= materia.nome %></span>
                    </label>
                <% }) %>
            </form>
            <button class="buscar-btn" id="buscarBtn">Buscar</button>
        </section>
    </aside>

    <!-- GRADE DE LIVROS -->
    <main class="livros-grid" id="livrosGrid">
        <% if (livros.length === 0) { %>
            <p class="livros-vazio">Nenhum livro publicado ainda.</p>
        <% } %>

        <% livros.forEach(function (livro) { %>
            <a href="/livro/<%= livro.id %>" class="livro-link">
                <article class="livro-card" data-disciplina="<%= livro.materiaSlug %>">
                    <img class="livro-cover" src="<%= livro.imagem_url || '../image/escolab.webp' %>" alt="<%= livro.titulo %>">
                    <section class="livro-info">
                        <p class="livro-titulo"><%= livro.titulo %></p>
                    </section>
                </article>
            </a>
        <% }) %>
    </main>

    <script src="../js/filtro.js"></script>
</body>
<%- include('../partials/footer.ejs') %>

</html>
