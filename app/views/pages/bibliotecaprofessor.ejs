<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biblioteca - Primia</title>

    <link href="../css/bibliotecaprofessor.css" rel="stylesheet">
    <link href="../css/excluiritem.css" rel="stylesheet">
    <%- include('../partials/headerprofessor.ejs') %>
        <%- include('../partials/botao.ejs', { tipoConteudo: 'livro', materias: typeof materiaParaAdicionar !== 'undefined' ? materiaParaAdicionar : [] }) %>
</head>

<body>
    <!-- HEADER -->
    <header class="biblioteca-header">
        <h1>Biblioteca</h1>
    </header>

    <%- include('../partials/filtroPadrao.ejs', { opcoesFiltro: materias.map(function (m) { return { valor: m.slug, nome: m.nome }; }) }) %>

    <!-- GRADE DE LIVROS -->

    <main class="livros-grid" id="livrosGrid">
        <% if (livros.length === 0) { %>
            <p class="livros-vazio">Nenhum livro publicado ainda.</p>
        <% } %>

        <% livros.forEach(function (livro) { %>
            <section class="livro-item">
                <a href="/livro/<%= livro.id %>" class="livro-link">
                    <article class="livro-card" data-disciplina="<%= livro.materiaSlug %>">
                        <img class="livro-cover" src="<%= livro.imagem_url || '../image/escolab.webp' %>" alt="<%= livro.titulo %>">
                        <section class="livro-info">
                            <p class="livro-titulo"><%= livro.titulo %></p>
                        </section>
                    </article>
                </a>
                <% if (livro.podeExcluir) { %>
                    <form action="/professor/conteudos/<%= livro.id %>/excluir" method="POST" class="form-excluir-item"
                        onsubmit="return confirm('Excluir o livro &quot;<%= livro.titulo %>&quot;? Essa ação não pode ser desfeita.');">
                        <button type="submit" class="botao-excluir-item">Excluir</button>
                    </form>
                <% } %>
            </section>
        <% }) %>
    </main>

    <script src="../js/filtro.js"></script>
</body>
<%- include('../partials/footer.ejs') %>

</html>
